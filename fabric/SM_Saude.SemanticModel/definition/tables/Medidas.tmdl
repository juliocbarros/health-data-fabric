/// Tabela para agrupar as medidas do modelo.
table Medidas
	lineageTag: 619b6ad6-77ff-4bd9-a1b6-ee09cabc3526

	/// Total de agendamentos.
	measure Agendamentos = COUNTROWS ( fato_agendamento )
		formatString: #,0
		displayFolder: Agendamentos
		lineageTag: 2953d7a4-3236-4e34-8010-88ed313e97e7

	/// Status Completed.
	measure 'Agendamentos Realizados' = SUM ( fato_agendamento[compareceu] )
		formatString: #,0
		displayFolder: Agendamentos
		lineageTag: e5c31a72-cf4e-4160-9fab-03649c77e614

	/// Status No show.
	measure Faltas = SUM ( fato_agendamento[faltou] )
		formatString: #,0
		displayFolder: Agendamentos
		lineageTag: ac461fc1-e4f1-4a6f-b7be-790859f51a2f

	/// Status Cancelled.
	measure Cancelamentos = SUM ( fato_agendamento[cancelado] )
		formatString: #,0
		displayFolder: Agendamentos
		lineageTag: 55dd8b4f-661d-4253-8a1c-02c0699d5599

	/// Realizados / (realizados + faltas). Ignora futuros e cancelados.
	measure 'Taxa de Comparecimento' = DIVIDE ( [Agendamentos Realizados], [Agendamentos Realizados] + [Faltas] )
		formatString: 0.0%
		displayFolder: Agendamentos
		lineageTag: 596712ac-d55a-4c6b-a582-6c875ba84fd8

	measure 'Taxa de Faltas' = DIVIDE ( [Faltas], [Agendamentos Realizados] + [Faltas] )
		formatString: 0.0%
		displayFolder: Agendamentos
		lineageTag: 49aa8547-e31b-48e5-be16-6f46d47f7390

	/// Cancelados / agendamentos já passados.
	measure 'Taxa de Cancelamento' = DIVIDE ( [Cancelamentos], CALCULATE ( [Agendamentos], fato_agendamento[status] <> "In Future" ) )
		formatString: 0.0%
		displayFolder: Agendamentos
		lineageTag: 24c1d8e9-5a48-456f-a9d9-67730737331f

	measure 'Agendamentos Futuros' = CALCULATE ( [Agendamentos], fato_agendamento[status] = "In Future" )
		formatString: #,0
		displayFolder: Agendamentos
		lineageTag: 5bbd2bc7-9242-4ab8-a8b8-e848be5b9897

	/// Usa a relação inativa; para analisar por quem agendou.
	measure 'Agendamentos Feitos pelo Atendente' = CALCULATE ( [Agendamentos], USERELATIONSHIP ( fato_agendamento[sk_atendente], dim_funcionario[sk_funcionario] ) )
		formatString: #,0
		displayFolder: Agendamentos
		lineageTag: ad51c90d-fbe4-4116-991b-3ca89f3846ca

	measure Diagnósticos = COUNTROWS ( fato_diagnostico )
		formatString: #,0
		displayFolder: Clínico
		lineageTag: c52fa5bd-6144-4b95-98f4-28b07f081a94

	measure 'Diagnósticos por Visita' = DIVIDE ( [Diagnósticos], DISTINCTCOUNT ( fato_diagnostico[sk_visita] ) )
		formatString: #,0.00
		displayFolder: Clínico
		lineageTag: 91a9521d-e55a-4770-8622-1329bb926c37

	measure 'Diagnósticos Crônicos' = CALCULATE ( [Diagnósticos], fato_diagnostico[status] = "Chronic" )
		formatString: #,0
		displayFolder: Clínico
		lineageTag: d7e05573-c4c8-48dc-8108-fcdc27ef1772

	/// Posição no último mês do filtro (não soma meses).
	measure 'Estoque Final' =
			VAR UltimoMes = MAX ( fato_estoque_mensal[mes_key] )
			RETURN
			    CALCULATE ( SUM ( fato_estoque_mensal[estoque_final] ), fato_estoque_mensal[mes_key] = UltimoMes )
		formatString: #,0
		displayFolder: Suprimentos
		lineageTag: 238ee282-1786-4967-b747-f48a04550169

	measure 'Entradas no Estoque' = SUM ( fato_estoque_mensal[qtd_recebida] )
		formatString: #,0
		displayFolder: Suprimentos
		lineageTag: f7fe7a68-4f11-4058-b186-77d16723e027

	measure 'Saídas do Estoque' = SUM ( fato_estoque_mensal[qtd_saida] )
		formatString: #,0
		displayFolder: Suprimentos
		lineageTag: 8fe62a73-2f9b-460d-a171-48c36ce97223

	/// Dias com estoque zerado ou negativo.
	measure '% Dias em Ruptura' = DIVIDE ( SUM ( fato_estoque_mensal[dias_em_ruptura] ), SUM ( fato_estoque_mensal[dias_com_registro] ) )
		formatString: 0.0%
		displayFolder: Suprimentos
		lineageTag: 27027460-6552-4a44-afac-d664e3c671ff

	measure 'Medicamentos com Estoque Negativo' = CALCULATE ( DISTINCTCOUNT ( fato_estoque_mensal[sk_medicamento] ), fato_estoque_mensal[fechou_negativo] = TRUE () )
		formatString: #,0
		displayFolder: Suprimentos
		lineageTag: 809417c4-5935-4239-87ee-6e4583856fd2

	measure Faturas = COUNTROWS ( fato_faturamento )
		formatString: #,0
		displayFolder: Financeiro
		lineageTag: c571df61-32dd-469c-95e1-84e6aab41157

	/// Atendimento + medicamentos, pela data de emissão.
	measure 'Valor Faturado' = SUM ( fato_faturamento[valor_fatura] )
		formatString: #,0.00
		displayFolder: Financeiro
		lineageTag: e29e068b-f8a4-491b-b729-8520a4b4e292

	measure 'Ticket Médio por Visita' = DIVIDE ( [Valor Faturado], DISTINCTCOUNT ( fato_faturamento[sk_visita] ) )
		formatString: #,0.00
		displayFolder: Financeiro
		lineageTag: a64da65d-7301-41c9-8a22-3e239cfc7bd1

	/// Parcelas concluídas, atribuídas à data de emissão da fatura.
	measure 'Valor Pago pelo Paciente' = SUM ( fato_faturamento[valor_pago_paciente] )
		formatString: #,0.00
		displayFolder: Financeiro
		lineageTag: 4816b950-1bd2-4ec5-ab50-69bd9e2cc9a6

	measure '% Faturas Negadas pelo Seguro' = DIVIDE ( CALCULATE ( [Faturas], fato_faturamento[status] = "Insurance Denied" ), [Faturas] )
		formatString: 0.0%
		displayFolder: Financeiro
		lineageTag: 60174c72-a333-49fe-95b9-186694bb3823

	/// Valor considerado perdido.
	measure 'Valor Baixado (Write-Off)' = CALCULATE ( [Valor Faturado], fato_faturamento[status] = "Write-Off" )
		formatString: #,0.00
		displayFolder: Financeiro
		lineageTag: c67ac9d9-77ce-4c6d-b6f5-2ae0329ecc63

	measure 'Valor em Análise pelo Seguro' = CALCULATE ( [Valor Faturado], fato_faturamento[status] = "Pending Insurance Review" )
		formatString: #,0.00
		displayFolder: Financeiro
		lineageTag: bd2d33eb-f825-42e8-86f2-c567fa99a787

	measure 'Lotes Recebidos' = COUNTROWS ( fato_fornecimento )
		formatString: #,0
		displayFolder: Suprimentos
		lineageTag: 608d8a5d-4899-4533-8a0a-109947b2e07f

	/// Custo total informado nos pagamentos ao fornecedor.
	measure 'Custo dos Fornecimentos' = SUM ( fato_fornecimento[custo_total] )
		formatString: #,0.00
		displayFolder: Suprimentos
		lineageTag: 4bc482c5-4d63-4202-ab5e-d104d4bd0fef

	measure 'Valor Pago a Fornecedores' = SUM ( fato_fornecimento[valor_pago] )
		formatString: #,0.00
		displayFolder: Suprimentos
		lineageTag: 11d8e3c3-3028-4312-8f75-54a4f61eabcc

	measure 'Saldo a Pagar a Fornecedores' = SUM ( fato_fornecimento[saldo_a_pagar] )
		formatString: #,0.00
		displayFolder: Suprimentos
		lineageTag: 0d1a6042-78bc-42e8-a61d-5ca55940b0fb

	/// Quantidade fornecida que não foi recebida.
	measure '% Divergência no Recebimento' = DIVIDE ( SUM ( fato_fornecimento[qtd_divergente] ), SUM ( fato_fornecimento[qtd_fornecida] ) )
		formatString: 0.0%
		displayFolder: Suprimentos
		lineageTag: 44301f8c-6501-4849-b137-670685abe102

	measure 'Dias Médios até Conferência' = AVERAGE ( fato_fornecimento[dias_ate_conferencia] )
		formatString: #,0.0
		displayFolder: Suprimentos
		lineageTag: 1ea53711-eef7-4e05-b384-8689779f554d

	/// Pela data de pagamento.
	measure 'Valor Recebido' = CALCULATE ( SUM ( fato_pagamento[valor_parcela] ), fato_pagamento[status] = "Completed" )
		formatString: #,0.00
		displayFolder: Financeiro
		lineageTag: c4307f96-664a-473c-ac2e-8a3cfb6feb88

	measure 'Valor Pendente' = CALCULATE ( SUM ( fato_pagamento[valor_parcela] ), fato_pagamento[status] = "Pending" )
		formatString: #,0.00
		displayFolder: Financeiro
		lineageTag: 1e2d32e1-8288-4b78-8824-1fa568f7c0d1

	measure '% Parcelas Pendentes' = DIVIDE ( CALCULATE ( COUNTROWS ( fato_pagamento ), fato_pagamento[status] = "Pending" ), COUNTROWS ( fato_pagamento ) )
		formatString: 0.0%
		displayFolder: Financeiro
		lineageTag: 04f713b8-3b37-4a0f-ab7a-fb886d69977a

	measure Prescrições = COUNTROWS ( fato_prescricao )
		formatString: #,0
		displayFolder: Clínico
		lineageTag: f6bb80f7-7425-42fd-9433-3c8d012a66c8

	/// Estimativa: quantidade x custo da embalagem.
	measure 'Custo Estimado de Medicamentos' = SUM ( fato_prescricao[custo_estimado] )
		formatString: #,0.00
		displayFolder: Clínico
		lineageTag: c254ac72-8f51-4a36-a77d-b7b1a8786dc3

	measure 'Medicamentos Prescritos (distintos)' = DISTINCTCOUNT ( fato_prescricao[sk_medicamento] )
		formatString: #,0
		displayFolder: Clínico
		lineageTag: 8907afb5-4e29-47a2-9f5c-80ceed4b8eea

	measure Tratamentos = COUNTROWS ( fato_tratamento )
		formatString: #,0
		displayFolder: Clínico
		lineageTag: 8451ce6d-30f0-4058-91fe-865d233754dc

	/// Falhou ou não tolerado.
	measure '% Tratamentos com Falha' = DIVIDE ( CALCULATE ( [Tratamentos], fato_tratamento[status] IN { "Failed", "Not Tolerated" } ), [Tratamentos] )
		formatString: 0.0%
		displayFolder: Clínico
		lineageTag: 5a3d94fe-297a-4554-bddd-64472f747943

	measure '% Tratamentos Recusados' = DIVIDE ( CALCULATE ( [Tratamentos], fato_tratamento[status] = "Declined" ), [Tratamentos] )
		formatString: 0.0%
		displayFolder: Clínico
		lineageTag: aadb97fe-42af-4e3f-b8fe-293824716122

	/// Por data de entrada.
	measure Visitas = COUNTROWS ( fato_visita )
		formatString: #,0
		displayFolder: Visitas
		lineageTag: 468c4a8e-ad8c-4c64-9ec6-c207e6faf814

	measure 'Pacientes Atendidos' = DISTINCTCOUNT ( fato_visita[sk_paciente] )
		formatString: #,0
		displayFolder: Visitas
		lineageTag: 68e7e988-bb62-4226-a9c4-c282212bfe56

	measure 'Permanência Média (dias)' = AVERAGE ( fato_visita[permanencia_dias] )
		formatString: #,0.0
		displayFolder: Visitas
		lineageTag: 664e92e8-598a-47ec-a663-94a93db14c95

	measure 'Visitas Internadas' = CALCULATE ( [Visitas], fato_visita[status] = "Admitted" )
		formatString: #,0
		displayFolder: Visitas
		lineageTag: f841cd85-1fc7-40f0-9376-414674f27db6

	measure 'Visitas com Retorno' = CALCULATE ( [Visitas], fato_visita[status] = "Need Follow-Up" )
		formatString: #,0
		displayFolder: Visitas
		lineageTag: e3bea4bc-3a5e-4fee-a250-20574ca7059a

	/// Visitas que vieram de agendamento.
	measure '% Visitas Agendadas' = DIVIDE ( CALCULATE ( [Visitas], fato_visita[origem] = "AGENDAMENTO" ), [Visitas] )
		formatString: 0.0%
		displayFolder: Visitas
		lineageTag: 0c985dde-1055-47a4-9c06-eeaf2944d8c2

	measure 'Visitas por Paciente' = DIVIDE ( [Visitas], [Pacientes Atendidos] )
		formatString: #,0.00
		displayFolder: Visitas
		lineageTag: 7137d043-ca8a-4645-b94e-5850fee8494e

	/// Conta pela data de saída (relação inativa).
	measure 'Altas por Data de Saída' = CALCULATE ( [Visitas], USERELATIONSHIP ( fato_visita[data_saida_key], dim_calendario[data_key] ) )
		formatString: #,0
		displayFolder: Visitas
		lineageTag: 37be026f-cf29-4e9f-8790-8d74b19de360

	/// Texto de alerta para o card de faturas negadas: Atenção a partir de 10%.
	measure 'Status Faturas Negadas' =
			VAR p = [% Faturas Negadas pelo Seguro]
			VAR n = ROUND ( DIVIDE ( 1, p ), 0 )
			RETURN
			    IF (
			        NOT ISBLANK ( p ),
			        IF ( p >= 0.10, "⚠ Atenção · ", "✓ Normal · " ) & "1 em cada " & n & " faturas"
			    )
		displayFolder: Financeiro
		lineageTag: c43e9e84-b9df-4573-be55-a9687e4c5ce6

	/// Rótulo do ticket médio para o card de faturas negadas.
	measure 'Ticket Médio Texto' = "Ticket médio por visita: " & FORMAT ( [Ticket Médio por Visita], "#,0.00" )
		displayFolder: Financeiro
		lineageTag: 62ef779e-ffeb-46f3-b9cd-fa069709d571

	column x
		isHidden
		isNameInferred
		sourceColumn: [x]

	partition Medidas = calculated
		mode: import
		source = ROW ( "x", BLANK () )

