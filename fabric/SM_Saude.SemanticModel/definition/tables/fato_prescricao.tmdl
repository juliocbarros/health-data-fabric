	measure Prescrições = COUNTROWS ( fato_prescricao )
		formatString: #,0
		displayFolder: Clínico
		lineageTag: f6bb80f7-7425-42fd-9433-3c8d012a66c8

	/// Estimativa: quantidade x custo da embalagem.
